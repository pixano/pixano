# syntax=docker/dockerfile:1

# The local-mode inference image: pixano-inference, plus its open_clip embedding plugin.
#
# pixano-inference ships the plugin in its tree (packages/pixano-inference-clip) but its
# Dockerfile has no switch to install it, so no image serving embeddings can be built from
# that tree alone. Rather than carry a patched copy of their Dockerfile, this one adds a
# single layer on top of the image theirs produces.
#
# Two named build contexts, both provided by docker-compose.inference.yml:
#   inference-base   the image built by pixano-inference's own Dockerfile
#   inference-src    a checkout of pixano-inference, for the plugin's sources

FROM ghcr.io/astral-sh/uv:0.8 AS uv

FROM inference-base

# The base image runs as an unprivileged user and owns its virtualenv as root.
USER root
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    --mount=from=inference-src,source=packages/pixano-inference-clip,target=/src/packages/pixano-inference-clip \
    --mount=from=inference-src,source=LICENSE,target=/src/LICENSE \
    --mount=type=cache,target=/root/.cache/uv \
    # Copied at the same depth as in the checkout: the plugin's metadata points two
    # directories up for its licence, and a build writes next to its sources, which the
    # mounted checkout, being read-only, does not allow.
    cp -r /src /tmp/inference-src \
    && uv pip install --python /opt/venv/bin/python /tmp/inference-src/packages/pixano-inference-clip \
    && rm -rf /tmp/inference-src
USER pixano
