# Pixano deployment configuration. Copy to .env and adapt.
#
# Nothing here is read by the application code: these are the values docker compose injects.
# Going from local mode to lab or cloud mode means changing this file — not the code.

# --- Database ----------------------------------------------------------------
# In local mode, the compose builds the DSN from the three variables below. A password
# containing @ : / or # would break the URL assembled this way: in that case, set
# PIXANO_DATABASE_URL directly, with the characters encoded.
# In a shared deployment, you are given a URL directly: uncomment PIXANO_DATABASE_URL,
# the three POSTGRES_* variables then only serve the local postgres container.
POSTGRES_USER=pixano
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pixano
POSTGRES_PORT=5432
# PIXANO_DATABASE_URL=postgresql://user:password@db.labo.interne:5432/pixano

# --- Inference ---------------------------------------------------------------
# Address of the inference server. With the docker-compose.inference.yml overlay, it is the
# compose's service; without it, the address of a server already in place.
PIXANO_INFERENCE_URL=http://pixano-inference:7463
PIXANO_INFERENCE_PORT=7463
# Mandatory as soon as the inference is shared between several machines.
PIXANO_INFERENCE_API_KEYS=
PIXANO_INFERENCE_API_KEY=
# Location of a clone of pixano-inference, as is, for the local build overlay only.
PIXANO_INFERENCE_REPO=../pixano-inference
# HuggingFace token for gated model weights (optional).
HF_TOKEN=

# --- Storage -----------------------------------------------------------------
# HOST side: what the compose mounts into the containers.
# Pixano data directory (contains library/, media/, models/, .pixano/).
PIXANO_DATA_DIR=./data
# Location of the media: a local folder, a mounted share, a file server.
PIXANO_MEDIA_DIR=./data/media
# CONTAINER side: where the worker will read the library, under the mount above.
PIXANO_LIBRARY_DIR=/data/library

# --- Media roots (CONTAINER side) --------------------------------------------
# The same storage seen from both sides. Locally the two roots coincide; as soon as the
# worker and the inference run on different machines, they no longer coincide, and the
# worker translates from one to the other before each call.
# This pair only covers the "both see the same storage" case. A dataset in object storage
# will go through presigned URLs, and a dataset left on its owner's machine is readable by
# neither — those are other strategies of the media resolver, not other values here.
PIXANO_MEDIA_ROOT=/medias
PIXANO_INFERENCE_MEDIA_ROOT=/medias

# --- Worker ------------------------------------------------------------------
# Chunks executed at once. A chunk spends most of its time waiting for the inference:
# tune it to what the inference server can take, not to the worker's cores.
PIXANO_WORKER_CONCURRENCY=4
# Demo job kinds (`fake`, `label`). Useful locally to put the engine to the test; leave
# false on a shared deployment, because they write wherever they are told to.
PIXANO_WORKER_DEMO_KINDS=true
# Beyond this duration, a chunk is held to be hung and returned to the queue. Must exceed
# the legitimate worst case of a job kind — an inference call and its retries.
PIXANO_WORKER_CHUNK_TIMEOUT_S=1800

# --- Application -------------------------------------------------------------
PIXANO_PORT=7492
# Nouvelle interface (ui/apps/web). À false, l'application sert l'interface legacy et masque
# le bouton qui mène à la nouvelle ; à true, le bouton apparaît et la nouvelle interface
# devient accessible.
ACTIVATE_UI_V1_0=false
