# Configuration du déploiement Pixano. Copier en .env et adapter.
#
# Rien ici n'est lu par le code applicatif : ce sont les valeurs que docker compose injecte.
# Passer du mode local au mode labo ou cloud, c'est changer ce fichier — pas le code.

# --- Base de données ---------------------------------------------------------
# En mode local, le compose fabrique la DSN à partir des trois variables ci-dessous. Un mot
# de passe contenant @ : / ou # casserait l'URL ainsi assemblée : dans ce cas, définir
# PIXANO_DATABASE_URL directement, avec les caractères encodés.
# En déploiement partagé, on vous donne directement une URL : décommentez PIXANO_DATABASE_URL,
# les trois variables POSTGRES_* ne servent alors plus qu'au conteneur postgres local.
POSTGRES_USER=pixano
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pixano
POSTGRES_PORT=5432
# PIXANO_DATABASE_URL=postgresql://user:password@db.labo.interne:5432/pixano

# --- Inference ---------------------------------------------------------------
# Adresse du serveur d'inférence. Avec l'overlay docker-compose.inference.yml, c'est le
# service du compose ; sans lui, l'adresse d'un serveur déjà en place.
PIXANO_INFERENCE_URL=http://pixano-inference:7463
PIXANO_INFERENCE_PORT=7463
# Obligatoire dès que l'inference est partagée entre plusieurs machines.
PIXANO_INFERENCE_API_KEYS=
PIXANO_INFERENCE_API_KEY=
# Emplacement du dépôt pixano-inference, pour l'overlay de build local uniquement.
PIXANO_INFERENCE_REPO=../pixano-inference
# Jeton HuggingFace pour les poids de modèles à accès restreint (optionnel).
HF_TOKEN=

# --- Stockage ----------------------------------------------------------------
# Côté HÔTE : ce que le compose monte dans les conteneurs.
# Répertoire de données Pixano (contient library/, media/, models/, .pixano/).
PIXANO_DATA_DIR=./data
# Emplacement des médias : un dossier local, un partage monté, un serveur de fichiers.
PIXANO_MEDIA_DIR=./data/media
# Côté CONTENEUR : où le worker va lire la bibliothèque, sous le montage ci-dessus.
PIXANO_LIBRARY_DIR=/data/library

# --- Racines médias (côté CONTENEUR) -----------------------------------------
# Le même stockage vu des deux côtés. En local les deux racines coïncident ; dès que le
# worker et l'inference tournent sur des machines différentes, elles ne coïncident plus, et
# le worker traduit de l'une vers l'autre avant chaque appel.
# Ce couple ne couvre que le cas « les deux voient le même stockage ». Un dataset en
# stockage objet passera par des URLs présignées, et un dataset resté sur la machine de son
# propriétaire n'est lisible par aucun des deux — ce sont d'autres stratégies du résolveur
# de médias, pas d'autres valeurs ici.
PIXANO_MEDIA_ROOT=/medias
PIXANO_INFERENCE_MEDIA_ROOT=/medias

# --- Worker ------------------------------------------------------------------
# Chunks exécutés à la fois. Un chunk passe l'essentiel de son temps à attendre l'inference :
# à régler selon ce que le serveur d'inference encaisse, pas selon les cœurs du worker.
PIXANO_WORKER_CONCURRENCY=4
# Types de jobs de démonstration (`fake`, `label`). Utiles en local pour éprouver le moteur ;
# à laisser à false sur un déploiement partagé, car ils écrivent où on leur dit.
PIXANO_WORKER_DEMO_KINDS=true
# Au-delà de cette durée, un chunk est tenu pour pendu et rendu à la file. Doit dépasser le
# pire cas légitime d'un type de job — un appel d'inférence et ses reprises.
PIXANO_WORKER_CHUNK_TIMEOUT_S=1800

# --- Application -------------------------------------------------------------
PIXANO_PORT=7492
